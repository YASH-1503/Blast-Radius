# Copy to `.env` and edit. Every value here has a working default, so the demo runs with no .env
# at all -- this file documents what exists rather than what is required.
#
# .gitignore excludes .env and .env.*, so a real credential put here is not committable.

# ---- database ---------------------------------------------------------------------------
# FALKOR_URL wins over the individual vars below. All four schemes are accepted, because
# FalkorDB Cloud's console shows different ones in different places:
#
#   falkor://host:6379                 plain
#   falkors://host:6379                TLS
#   redis://user:pass@host:6379        plain, credentials inline
#   rediss://user:pass@host:6379       TLS, credentials inline
#
# FalkorDB Cloud is NOT TLS-only, which is the opposite of what this file said for two days.
# TLS starts at the STARTUP tier. The FREE tier (100 MB RAM, no credit card) has no TLS, so a free
# Cloud instance is reached with a PLAIN scheme plus a password, and falkors:// against it fails.
# Use falkors:// / rediss:// only on Startup and above. A plain scheme against a TLS endpoint
# fails at connection time with an error that does not mention TLS, so match the scheme to the
# tier rather than guessing. A password containing @ or : is fine -- percent-encode it and it is
# decoded on parse.
#
# FALKOR_URL=falkors://user:p%40ssword@my-instance.falkordb.cloud:6379

FALKOR_HOST=127.0.0.1
FALKOR_PORT=6379
# FALKOR_USER=
# FALKOR_PASSWORD=
FALKOR_TLS=false

# ---- API authentication -----------------------------------------------------------------
# `key:tenant,key:tenant`. The tenant is derived from the key and NEVER from the request, so a
# caller cannot read another tenant's graph by editing a URL.
#
# Leave BR_API_KEYS unset and the server GENERATES keys at startup and prints them -- it does not
# serve open. Turning auth off is possible but has to be chosen explicitly:
#
# BR_API_KEYS=brk_acme_xxxxxxxx:acme,brk_globex_yyyyyyyy:globex
BR_AUTH_REQUIRED=true

# ---- data -------------------------------------------------------------------------------
TENANT=acme

# Same seed -> byte-identical synthetic layer, so the demo can be rehearsed and recorded.
SEED=20261015

# The repository supplying the REAL human layer (people, commits, pull requests).
# Any public repo works: the path map is discovered from its own directory tree.
GITHUB_REPO=FalkorDB/FalkorDB

# Optional. Unauthenticated is 60 requests/hour and a full fetch costs ~31, so a token is not
# needed for one repo -- it is needed to load several in the same hour. Scope: none required;
# public repository reads need no permissions at all.
# GITHUB_TOKEN=

# ---- embeddings -------------------------------------------------------------------------
# 384 matches fastembed's default model. Changing it after ingest requires a re-ingest, because
# the vector index is created with a fixed dimension.
EMBEDDING_DIM=384
